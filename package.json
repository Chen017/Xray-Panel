{
  "name": "xray-panel",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/package-source.mjs",
    "package": "node scripts/package-release.mjs",
    "start": "node server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:agent": "python -m unittest discover -s agent/tests -v",
    "test:e2e": "node tests/e2e.mjs",
    "test:release": "node tests/release-smoke.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/notifications": "^8.3.0",
    "@tabler/icons-react": "^3.35.0",
    "age-encryption": "^0.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
