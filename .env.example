# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_MASTER_KEY=replace-with-64-hex-characters
# 仅在首次创建数据库时使用，至少 16 字符
PANEL_ADMIN_PASSWORD=replace-with-a-long-random-password
PANEL_ADMIN_ORIGIN=https://panel.example.com
PANEL_SUBSCRIPTION_ORIGIN=https://sub.example.com
PANEL_AGENT_ORIGIN=https://agent.example.com
PANEL_SECURE_COOKIE=true
PANEL_HOST=0.0.0.0
PANEL_DB=/app/data/panel.sqlite
